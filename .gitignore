# ~/dotfiles/.gitignore

# Ignorar archivos de claves y certificados
**/.ssh/*
**/*.pem
**/*.key
**/*.pub

# Ignorar archivos de variables de entorno (claves API, DB)
**/.env
**/.env.*

# Ignorar cachés y temporales
**/.cache/
**/.npm/
**/node_modules/

# Ignorar archivos de historial (pueden contener contraseñas tecleadas)
**/*_history
# Ignorar backups locales
**/*.bkup
**/.zsh_secrets

# Generado por hypr_tweak.sh (panel Ajustes de eww): es estado local, no config.
# setup/link.sh lo crea vacio para que el source de hyprland.conf no falle.
hypr/.config/hypr/conf.d/overrides.conf
