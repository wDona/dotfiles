              {p}))))
      (box :class "perso-section" :orientation "v" :space-evenly false :spacing 6
        (label :class "perso-sub" :halign "start" :text "Colores (click = elegir)")
        (color-row :key "bg"      :label "Fondo"       :hex {ewwcols.bg})
        (color-row :key "bg_cell" :label "Fondo celda" :hex {ewwcols.bg_cell})
        (color-row :key "surface" :label "Superficie"  :hex {ewwcols.surface})
        (color-row :key "accent"  :label "Acento"      :hex {ewwcols.accent})
        (color-row :key "accent2" :label "Acento 2"    :hex {ewwcols.accent2})
        (color-row :key "fg"      :label "Texto"       :hex {ewwcols.fg})
        (color-row :key "fg_dim"  :label "Texto tenue" :hex {ewwcols.fg_dim})
        (color-row :key "lila"    :label "Lila"        :hex {ewwcols.lila}))
      (box :class "perso-section" :orientation "v" :space-evenly false :spacing 6
        (label :class "perso-sub" :halign "start" :text "Ventanas eww")
        (for win in ewwwins
          (box :class "conf-item" :space-evenly false :spacing 8
            (label :class "conf-name" :hexpand true :halign "start" :text {win.name})
            (button :class "mini-btn" :onclick `eww open --toggle ${win.name}` "󰈈")
            (button :class "mini-btn" :onclick `~/.config/eww/scripts/conf_open.sh eww &` "󰨞")))))))

;; ── Submenu: Configuraciones (lista dinamica de `conf --list`) ──
(defwidget aj-confs []
  (scroll :vscroll true :hscroll false :height 540
    (box :orientation "v" :space-evenly false :spacing 6
      (for c in confs
        (button :class "conf-item" :onclick `eww update view=conf conf_sel="${c.name}"`
          (box :space-evenly false :spacing 10
            (label :class "conf-ico" :text "")
            (label :class "conf-name" :hexpand true :halign "start" :text {c.name})
            (label :class "conf-chev" :text "󰅂")))))))

;; ── Detalle de un conf concreto (controles + editor) ──
(defwidget aj-detail []
  (box :orientation "v" :space-evenly false :spacing 16
    ;; kitty: opacidad
    (box :class "perso-section" :orientation "v" :space-evenly false :spacing 8
         :visible {conf_sel == "kitty"}
      (box :space-evenly false
        (label :class "perso-sub" :hexpand true :halign "start" :text "Opacidad del fondo")
        (label :class "val-badge" :text "${kitty_op}%"))
      (scale :hexpand true :min 0 :max 100 :value kitty_op
             :onchange "~/.config/hypr/scripts/kitty_opacity.sh {}"))

    ;; sin controles rapidos (todo lo que no sea kitty)
    (box :class "perso-section" :orientation "v" :space-evenly false :spacing 6
         :visible {conf_sel != "kitty"}
      (label :class "conf-empty" :wrap true :halign "start"
             :text "Sin controles rapidos para «${conf_sel}». Usa el editor para cambios detallados."))

    ;; Editar en VSCode (siempre)
    (button :class "wp-browse" :onclick `~/.config/eww/scripts/conf_open.sh "${conf_sel}" &`
      (box :space-evenly false :spacing 8 :halign "center"
        (label :text "󰨞") (label :text "Editar en VSCode")))))

;; ── Router del panel ──
(defwidget perso []
  (box :class "perso" :orientation "v" :space-evenly false :spacing 12
    (box :class "perso-head" :space-evenly false
      (button :class "perso-back" :visible {view != "home"}
              :onclick `eww update view=${view == "conf" ? "confs" : "home"}` "󰁍")
      (label :class "perso-title" :hexpand true :halign "start"
             :text {view == "home"      ? "󰒓  Ajustes" :
                    view == "wallpaper" ? "󰸉  Fondo de pantalla" :
                    view == "gtk"       ? "󰏘  Tema GTK" :
                    view == "icon"      ? "󰋩  Iconos" :
                    view == "cursor"    ? "󰳽  Cursor" :
                    view == "fonts"     ? "󰛖  Fuentes" :
                    view == "bt"        ? "󰂯  Bluetooth" :
                    view == "hypr"      ? "  Hyprland" :
                    view == "eww"       ? "󰕷  eww" :
                    view == "confs"     ? "  Configuraciones" :
                                          "  conf · ${conf_sel}"})
      )   ;; sin X: cerrar es click fuera / ESC / otro click en el modulo,
          ;; igual que en el resto. Apuntar a una X de 16px es la forma mas
          ;; cara de cerrar algo.
    (box :visible {view == "home"}      (aj-home))
    (box :visible {view == "wallpaper"} (aj-wallpaper))
    (box :visible {view == "gtk"}       (aj-gtk))
    (box :visible {view == "icon"}      (aj-icon))
    (box :visible {view == "cursor"}    (aj-cursor))
    (box :visible {view == "fonts"}     (aj-fonts))
    (box :visible {view == "bt"}       (aj-bt))
    (box :visible {view == "hypr"}      (aj-hypr))
    (box :visible {view == "eww"}       (aj-eww))
    (box :visible {view == "confs"}     (aj-confs))
    (box :visible {view == "conf"}      (aj-detail))))

;; ─── Ventanas ─────────────────────────────────────────────
;; TODAS estas ventanas entran y salen de arriba a abajo, y eso NO se hace
;; aqui: lo hace Hyprland con
;;     layerrule = animation slide top, match:namespace gtk-layer-shell
;; (hypr/conf.d/styles.conf). Un revealer dentro del yuck solo anima la
;; APERTURA: al cerrar, `eww close` destruye la ventana en el mismo frame y el
;; panel desaparece de golpe. La regla de Hyprland cubre las dos direcciones.
(defwindow dashboard
  :monitor 0
  :stacking "overlay"
  :geometry (geometry :x "0px" :y "5px" :width "330px" :anchor "top right")
  (dashboard))

(defwindow calendario
  :monitor 0
  :stacking "overlay"
  ;; anchor centrado: el x absoluto de antes (829px) estaba calibrado a ojo
  ;; para 1920 de ancho y se salia por la derecha en DP-1 (1360).
  ;; sin :height -> la ventana se ajusta al contenido (5 o 6 semanas, panel de
  ;; eventos desplegado o no) en lugar de quedarse en 580px fijos.
  :geometry (geometry :x "0px" :y "0px" :width "346px" :anchor "top center")
  (cal_widget))

;; Capa transparente a pantalla completa que va DEBAJO del popup abierto: un
;; click en cualquier sitio lo cierra, sin tener que apuntar a ninguna X.
;; No tapa la barra porque waybar reserva su franja con exclusive zone y los
;; layer-shell empiezan por debajo; asi saltar de un popup a otro sigue siendo
;; un solo click sobre el modulo.
;; La abre y la cierra popup.sh, nunca a mano.
(defwindow backdrop
  :monitor 0
  :stacking "overlay"
  :focusable false
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "100%" :anchor "top center")
  ;; button y no eventbox: el click es la razon de ser de esta ventana y el
  ;; boton es el widget que lo tiene garantizado en todas las versiones de eww.
  (button :class "backdrop" :onclick "~/.config/eww/scripts/popup.sh close"))

;; ── Popups de la barra ──
;; Todos con la misma UX de cierre (click fuera / ESC / otro click en el
;; modulo), gestionada por scripts/popup.sh. NINGUNO lleva onhoverlost.
;;
;; La x se mide, no se estima: es la distancia del BORDE DERECHO de la ventana
;; al borde derecho del monitor, asi que para centrar el popup bajo su modulo
;;     x = (ancho_monitor - centro_del_modulo) - ancho_popup / 2
;; Centros medidos en DP-1 (borde derecho 3280): clima 3062, timer 3124,
;; pulseaudio 3160, power 3237. Cuando el resultado sale negativo, el popup es
;; mas ancho que el hueco y se queda pegado al borde con 5px de aire.
(defwindow sysmenu
  :monitor 0
  :stacking "overlay"
  :geometry (geometry :x "5px" :y "5px" :width "300px" :anchor "top right")
  (sysmenu))

(defwindow batmenu
  :monitor 0
  :stacking "overlay"
  ;; En sobremesa el modulo de bateria se colapsa (#custom-battery.none), asi
  ;; que esta x solo importa en portatil: queda a la izquierda de pulseaudio.
  :geometry (geometry :x "140px" :y "5px" :width "230px" :anchor "top right")
  (batmenu))

;; Ya no queda ninguna ventana focusable: ninguna se apropia del teclado, y por
;; eso la barra y el click-fuera responden igual con cualquier popup abierto.

(defwindow personalizacion
  :monitor 0
  :stacking "overlay"
  :geometry (geometry :x "5px" :y "5px" :width "560px" :anchor "top right")
  (perso))

;; ══════════════════════════════════════════════════════════
;; ─── CLIMA ────────────────────────────────────────────────
;; ══════════════════════════════════════════════════════════

;; Una card del pronostico: dia, icono, max/min y los avisos de ESE dia.
;; Van en rejilla 2x2, asi que hay ancho de sobra para el nombre del aviso al
;; lado de la hora; el tooltip da el rango largo con el dia.
(defwidget wt-day [d]
  (box :class "wt-day" :orientation "v" :space-evenly false :spacing 6
    (box :space-evenly false
      (label :class "wt-day-name" :hexpand true :halign "start" :text {d.name})
      (label :class "wt-day-ico"  :text {d.icon}))
    (box :space-evenly false :spacing 6 :halign "start"
      (label :class "wt-day-max" :text "${d.max}°")
      (label :class "wt-day-min" :text "${d.min}°"))
    (box :orientation "v" :space-evenly false :spacing 3
         :visible {arraylength(d.alerts) > 0}
      (for a in {d.alerts}
        (box :class "wt-alert ${a.color}" :space-evenly false :spacing 6
             :tooltip "${a.text}: ${a.when}"
          (label :class "wt-alert-ico" :text {a.icon})
          (label :class "wt-alert-txt" :hexpand true :halign "start" :text {a.text})
          (label :class "wt-alert-when" :text {a.hours}))))))

;; Una metrica del bloque inferior (sensacion / humedad / viento)
(defwidget wt-stat [icon label value]
  (box :class "wt-stat" :orientation "v" :space-evenly false :spacing 2
    (label :class "wt-stat-ico" :text icon)
    (label :class "wt-stat-val" :text value)
    (label :class "wt-stat-lbl" :text label)))

(defwidget weather []
  (box :class "wt-box" :orientation "v" :space-evenly false :spacing 14
    ;; cabecera: ciudad + boton refrescar
    (box :class "wt-header" :space-evenly false
      (label :class "wt-city" :hexpand true :halign "start"
             :text {weather_json.city})
      (button :class "wt-refresh" :tooltip "Actualizar"
              :onclick "rm -f ~/.cache/eww-weather.json; eww update weather_json=\"$(~/.config/eww/scripts/weather.sh json)\""
              "󰑐"))

    ;; actual: iconazo + temperatura + descripcion
    (box :class "wt-now" :space-evenly false :spacing 16
      (label :class "wt-now-ico" :text {weather_json.icon})
      (box :orientation "v" :space-evenly false :valign "center"
        (label :class "wt-now-temp" :halign "start" :text "${weather_json.temp}°")
        (label :class "wt-now-desc" :halign "start" :text {weather_json.desc})))

    ;; metricas
    (box :class "wt-stats" :space-evenly true
      (wt-stat :icon "󰔏" :label "Sensacion" :value "${weather_json.feels}°")
      (wt-stat :icon "󰖎"   :label "Humedad"   :value "${weather_json.hum}%")
      (wt-stat :icon "󰖝"  :label "Viento"    :value "${weather_json.wind}km/h"))

    (box :class "wt-sep")

    ;; pronostico en rejilla 2x2. Indices fijos porque el script siempre manda
    ;; 4 dias (hoy + 3), que es justo el horizonte de los avisos de AEMET: por
    ;; eso cada aviso cabe dentro de su card y no hace falta lista aparte.
    (box :class "wt-days" :orientation "v" :space-evenly false :spacing 8
      (box :space-evenly true :spacing 8
        (wt-day :d {weather_json.days[0]})
        (wt-day :d {weather_json.days[1]}))
      (box :space-evenly true :spacing 8
        (wt-day :d {weather_json.days[2]})
        (wt-day :d {weather_json.days[3]})))))

(defwindow clima
  :monitor 0
  :stacking "overlay"
  ;; Esta geometria es solo el respaldo: toggle_weather.sh abre la ventana con
  ;; --anchor "top left" --pos calculado, centrandola bajo el raton (o sea bajo
  ;; el modulo, que es donde se acaba de hacer click) y recortada a los bordes
  ;; del monitor con foco. Asi vale para cualquier resolucion y deja de depender
  ;; de un x medido a mano, que se descalibraba con el ancho del titulo de
  ;; Spotify o con el temporizador al colapsarse.
  ;; ANCHO: si cambia el :width, cambiarlo tambien en toggle_weather.sh (W).
  :geometry (geometry :x "18px" :y "5px" :width "330px" :anchor "top right")
  (weather))

;; ══════════════════════════════════════════════════════════
;; ─── VOLUMEN ──────────────────────────────────────────────
;; ══════════════════════════════════════════════════════════

;; Sondeo rapido para que el popup refleje cambios hechos fuera (rueda del
;; raton sobre la barra, teclas de volumen, pavucontrol). 300ms es suficiente
;; para que se sienta inmediato sin castigar la CPU.
;; Ojo: no puede ser mucho mas lento o al arrastrar el slider el valor
;; sondeado llega tarde y "tira" del pulgar hacia atras.
(defpoll vol_pct   :interval "300ms" `~/.config/eww/scripts/vol.sh get`)
(defpoll vol_muted :interval "300ms" `~/.config/eww/scripts/vol.sh muted`)

(defwidget volmenu []
  (box :class "volmenu" :orientation "v" :space-evenly false :spacing 10
    (box :space-evenly false :spacing 10
      ;; Click en el icono = silenciar. El icono ya indica el estado.
      (button :class "vol-ico ${vol_muted == "true" ? "muted" : ""}"
              :onclick "~/.config/eww/scripts/vol.sh toggle"
        {vol_muted == "true" ? "󰝟" : "󰕾"})
      (label :class "vol-val" :hexpand true :halign "end"
             :text {vol_muted == "true" ? "Silenciado" : "${vol_pct}%"}))

    ;; :onchange dispara en CADA paso del arrastre, no al soltar: por eso el
    ;; volumen cambia en vivo con el boton del raton pulsado.
    (scale :class "vol-scale"
           :hexpand true
           :min 0
           :max 100
           :value vol_pct
           :onchange "~/.config/eww/scripts/vol.sh set {}")))

(defwindow volumen
  :monitor 0
  :stacking "overlay"
  ;; 120 - 120 = 0, subido a 5 para no pegarlo al filo de la pantalla
  ;; (centro del modulo pulseaudio medido en 3160; antes x=95 lo dejaba 95px
  ;; a la izquierda del icono)
  :geometry (geometry :x "5px" :y "5px" :width "240px" :anchor "top right")
  (volmenu))

;; ══════════════════════════════════════════════════════════
;; ─── SPOTIFY ──────────────────────────────────────────────
;; ══════════════════════════════════════════════════════════

;; Sin defpoll ni deflisten a proposito: lo rellena toggle_spotify.sh antes de
;; abrir, y spotify.sh lo reescribe despues de cada boton. Un panel que se mira
;; tres segundos no justifica un proceso vivo (ni un fork por intervalo) el
;; resto del dia. Ver la cabecera de scripts/spotify.sh.
(defvar spotify_json "{\"open\":false,\"playing\":false,\"title\":\"\",\"artist\":\"\",\"shuffle\":false,\"loop\":\"None\",\"vol\":0}")

(defwidget sp-btn [icon onclick ?active ?big ?tip]
  (button :class "sp-btn ${(active ?: false) ? "on" : ""} ${(big ?: false) ? "big" : ""}"
          :tooltip {tip ?: ""}
          :onclick onclick
    icon))

(defwidget spotifymenu []
  (box :class "spmenu" :orientation "v" :space-evenly false :spacing 12

    (box :orientation "v" :space-evenly false :spacing 1
      (label :class "sp-title"  :halign "start" :limit-width 26 :text {spotify_json.title})
      (label :class "sp-artist" :halign "start" :limit-width 30 :text {spotify_json.artist}))

    ;; Anterior/siguiente estan aqui ADEMAS de en los clicks de waybar, por si
    ;; algun click de la barra deja de responder.
    ;; setsid -f en TODOS, y no es adorno: eww se lleva por delante al hijo del
    ;; onclick en cuanto vuelve del click, asi que playerctl (inmediato) si
    ;; corria pero el refresco que spotify.sh hace 0.3s despues moria con el.
    ;; De ahi el sintoma: la cancion cambiaba de modo pero el boton se quedaba
    ;; con el estado viejo hasta cerrar y reabrir el popup. Con setsid el script
    ;; sale del arbol de eww y termina su trabajo. Mismo truco que ya usaban
    ;; note_edit.sh y today.sh en el calendario.
    (box :class "sp-controls" :space-evenly false :spacing 4 :halign "center"
      (sp-btn :icon "󰒝"
              :active {spotify_json.shuffle}
              :tip {spotify_json.shuffle ? "Aleatorio: activado" : "Aleatorio: desactivado"}
              :onclick "setsid -f ~/.config/eww/scripts/spotify.sh action shuffle")
      (sp-btn :icon "󰒮" :tip "Anterior"
              :onclick "setsid -f ~/.config/eww/scripts/spotify.sh action previous")
      (sp-btn :icon {spotify_json.playing ? "󰏤" : "󰐊"} :big true
              :tip {spotify_json.playing ? "Pausar" : "Reproducir"}
              :onclick "setsid -f ~/.config/eww/scripts/spotify.sh action play-pause")
      (sp-btn :icon "󰒭" :tip "Siguiente"
              :onclick "setsid -f ~/.config/eww/scripts/spotify.sh action next")
      ;; Un solo boton para los tres estados de repeticion: el glifo cambia a
      ;; "repetir una" cuando el modo es Track.
      (sp-btn :icon {spotify_json.loop == "Track" ? "󰑘" : "󰑖"}
              :active {spotify_json.loop != "None"}
              :tip {spotify_json.loop == "Track"    ? "Repetir: esta cancion" :
                    spotify_json.loop == "Playlist" ? "Repetir: la lista" :
                                                      "Repetir: desactivado"}
              :onclick "setsid -f ~/.config/eww/scripts/spotify.sh action loop"))

    ;; Volumen del stream de Spotify, no del sink por defecto: mover esto no
    ;; toca el volumen del resto del sistema.
    (box :class "sp-vol" :space-evenly false :spacing 8
      (label :class "sp-vol-ico" :text "󰝚")
      (scale :class "vol-scale" :hexpand true :min 0 :max 100
             :value {spotify_json.vol}
             :onchange "~/.config/eww/scripts/spotify.sh vol {}"))))

(defwindow spotify
  :monitor 0
  :stacking "overlay"
  ;; Medido pintando #mpris de verde y buscando las columnas en una captura de
  ;; grim sobre DP-1 (1920 de ancho): el modulo ocupa 1629..1716, o sea su borde
  ;; DERECHO cae a 204px del filo del monitor.
  ;;
  ;; Se ancla a ese borde derecho y no al centro a proposito: `modules-right`
  ;; empaqueta desde la derecha, asi que al alargarse el titulo el modulo crece
  ;; hacia la IZQUIERDA y su borde derecho no se mueve. Centrarlo obligaria a
  ;; recalibrar con cada cancion.
  ;;
  ;; x=170 deja el filo derecho del popup 34px por fuera del modulo, que con
  ;; :width 300 lo mantiene dentro del panel hasta titulos de ~300px.
  :geometry (geometry :x "170px" :y "5px" :width "300px" :anchor "top right")

  (spotifymenu))
